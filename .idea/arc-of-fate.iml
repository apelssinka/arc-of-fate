    <meta name="keywords" content="Arc of Fate, Арка Судьбы, Акихару, NEX, Каролина, научная фантастика, сайт арка судьбы, комикс, apelsinka, apelssinka, апельсинка, киберпанк, веб-комикс, манга">
    <meta name="author" content="apelssinka">
    <meta property="og:title" content="Arc of Fate — комикс">
    <meta property="og:description" content="Киберпанк-комикс о девушке, пережившей эксперименты, и бессмертном учёном.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://github.io">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Arc of Fate — комикс">
    <meta name="twitter:description" content="Киберпанк-комикс о девушке, пережившей эксперименты, и бессмертном учёном.">
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://w3.org' viewBox='0 0 100 100'%3E%3Ctext x='50' y='80' font-size='70' text-anchor='middle' fill='%23ff3366' font-family='monospace'%3E⌇%3C/text%3E%3C/svg%3E">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        html {
            scroll-behavior: smooth; /* Плавный скролл по якорным ссылкам */
        }

        body {
            background-color: #0a0a0a;
            color: #00cc66;
            font-family: 'Courier New', 'Fira Code', monospace;
            line-height: 1.6;
            padding: 20px;
            position: relative;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .code-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;
            overflow: hidden; font-family: monospace; font-size: 14px; line-height: 1.4;
            color: rgba(0, 204, 102, 0.25); pointer-events: none;
            display: flex; flex-direction: column; justify-content: space-around;
        }
        .code-row {
            white-space: nowrap; font-size: 14px; display: flex; gap: 20px;
            margin-bottom: 10px; animation: scrollRow 30s linear infinite; width: max-content;
        }
        .code-row span { display: inline-block; padding-right: 30px; }
        @keyframes scrollRow {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .glitch-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0,0,0,0.2) 0px, rgba(0,0,0,0.2) 2px, transparent 2px, transparent 6px);
            pointer-events: none; z-index: 1; animation: noise 0.15s infinite;
        }
        @keyframes noise {
            0% { opacity: 0.3; transform: translateX(0); }
            20% { opacity: 0.5; transform: translateX(-1px); }
            40% { opacity: 0.3; transform: translateX(1px); }
            60% { opacity: 0.6; transform: translateX(0); }
            80% { opacity: 0.4; transform: translateX(2px); }
            100% { opacity: 0.3; transform: translateX(-1px); }
        }

        .container {
            max-width: 1100px; margin: 0 auto; background: rgba(10,10,10,0.85);
            border: 1px solid #00cc66; box-shadow: 0 0 20px rgba(0,204,102,0.2);
            padding: 30px; border-radius: 8px; position: relative; z-index: 2; overflow: visible;
        }

        h1, h2, h3 {
            color: #ff3366; text-transform: uppercase; letter-spacing: 2px;
            border-bottom: 1px solid #ff3366; display: inline-block; margin-bottom: 20px; font-weight: normal;
        }
        h1 { font-size: 2.5rem; border-bottom: none; text-shadow: 0 0 5px #ff3366; }

        a, .nav-link { color: #00cc66; text-decoration: none; border-bottom: 1px dashed #00cc66; transition: 0.3s; cursor: pointer; }
        a:hover, .nav-link:hover { color: #ff3366; border-bottom-color: #ff3366; }

        .glitch-link { display: inline-block; transition: 0.1s; }
        .glitch-link:hover { animation: linkGlitch 0.2s infinite; color: #ff3366; }
        @keyframes linkGlitch {
            0% { text-shadow: -1px 0 #ff3366, 1px 0 #00cc66; }
            50% { text-shadow: 1px 0 #ff3366, -1px 0 #00cc66; }
            100% { text-shadow: 0 0 #ff3366; }
        }

        nav {
            margin: 20px 0; padding: 10px 0; border-top: 1px solid #00cc66;
            border-bottom: 1px solid #00cc66; display: flex; gap: 20px; flex-wrap: wrap;
        }
        nav a { border-bottom: none; font-weight: bold; }

        .characters-grid { display: flex; flex-wrap: wrap; gap: 30px; justify-content: center; margin: 40px 0; }
        .character-card { text-align: center; cursor: pointer; min-width: 140px; }
        .character-frame {
            padding: 15px 25px; border: 2px solid #00cc66; background: #0a0a0a;
            transition: all 0.2s; animation: frameGlitch 4s infinite;
        }
        @keyframes frameGlitch {
            0% { border-color: #00cc66; box-shadow: 0 0 0 rgba(0,204,102,0); }
            95% { border-color: #00cc66; box-shadow: 0 0 0 rgba(0,204,102,0); }
            96% { border-color: #ff3366; box-shadow: 0 0 5px #ff3366; transform: skewX(0.5deg); }
            97% { border-color: #00cc66; box-shadow: 0 0 0 #ff3366; transform: skewX(-0.5deg); }
            98% { border-color: #ff3366; box-shadow: 0 0 3px #ff3366; }
            100% { border-color: #00cc66; box-shadow: 0 0 0 rgba(0,204,102,0); }
        }
        .character-card:hover .character-frame { border-color: #ff3366; animation: frameHoverGlitch 0.2s infinite; transform: scale(1.02); }
        @keyframes frameHoverGlitch {
            0% { border-color: #ff3366; transform: translateX(0); }
            25% { border-color: #00cc66; transform: translateX(-1px); }
            75% { border-color: #ff3366; transform: translateX(1px); }
            100% { border-color: #ff3366; transform: translateX(0); }
        }
        .character-name { font-size: 1.1rem; letter-spacing: 2px; font-weight: bold; color: #00cc66; text-transform: uppercase; }
        .character-card:hover .character-name { color: #ff3366; text-shadow: 0 0 3px #ff3366; }

        .about-section { margin: 30px 0; padding: 20px; background: rgba(0,204,102,0.02); border-left: 3px solid #ff3366; }

        .floating-buttons { position: fixed; bottom: 20px; right: 20px; z-index: 50; display: flex; flex-direction: column; gap: 10px; }
        .floating-btn {
            background: #0a0a0a; border: 1px solid #00cc66; padding: 12px 18px; cursor: pointer;
            transition: 0.3s; box-shadow: 0 0 15px rgba(0,204,102,0.2); color: #00cc66;
            font-family: 'Courier New', monospace; font-size: 0.85rem; letter-spacing: 1px;
            text-align: center; text-decoration: none;
        }
        .floating-btn:hover { border-color: #ff3366; box-shadow: 0 0 25px rgba(255,51,102,0.3); color: #ff3366; text-shadow: 0 0 5px #ff3366; }

        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); z-index: 100; justify-content: center; align-items: center;
            flex-direction: column;
        }
        .modal-overlay.active { display: flex; }

        .modal-content {
            background: #0a0a0a; border: 1px solid #ff3366;
            box-shadow: 0 0 30px rgba(255,51,102,0.3), inset 0 0 30px rgba(255,51,102,0.05);
            padding: 30px; max-width: 600px; width: 90%; max-height: 85vh; overflow-y: auto;
            position: relative; border-radius: 4px; animation: modalIn 0.3s ease-out;
        }
        @keyframes modalIn { 0% { opacity: 0; transform: scale(0.9); } 100% { opacity: 1; transform: scale(1); } }
        .modal-content::-webkit-scrollbar { width: 5px; }
        .modal-content::-webkit-scrollbar-track { background: #0a0a0a; }
        .modal-content::-webkit-scrollbar-thumb { background: #ff3366; border-radius: 3px; }

        .modal-close {
            position: sticky; top: 0; float: right; color: #ff3366; font-size: 24px;
            cursor: pointer; border: none; background: none; font-family: monospace; transition: 0.2s;
            z-index: 101;
        }
        .modal-close:hover { text-shadow: 0 0 10px #ff3366; transform: scale(1.2); }

        .modal-character-name {
            text-align: center; font-size: 1.6rem; color: #ff3366; text-shadow: 0 0 10px #ff3366;
            letter-spacing: 3px; margin-bottom: 15px; text-transform: uppercase;
        }

        .hologram-container { position: relative; width: 250px; height: 350px; margin: 0 auto 25px;
            display: flex; justify-content: center; align-items: center; }

        .hologram-image {
            max-width: 100%; max-height: 100%; object-fit: contain;
            filter: drop-shadow(0 0 15px rgba(255,51,102,0.6)) drop-shadow(0 0 30px rgba(255,51,102,0.3)) drop-shadow(0 0 60px rgba(255,51,102,0.15));
            opacity: 0.8; animation: hologramFloat 3s ease-in-out infinite, hologramFlicker 4s infinite;
            mix-blend-mode: screen;
        }

        @keyframes hologramFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
        @keyframes hologramFlicker {
            0% { opacity: 0.8; } 5% { opacity: 0.85; } 10% { opacity: 0.75; } 15% { opacity: 0.85; } 20% { opacity: 0.8; }
            50% { opacity: 0.7; } 52% { opacity: 0.9; } 54% { opacity: 0.75; } 56% { opacity: 0.8; } 100% { opacity: 0.8; }
        }

        .hologram-platform {
