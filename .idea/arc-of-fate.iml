<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arc of Fate</title>
    
    <meta name="yandex-verification" content="2f4b656845ef9f38" />
    <meta name="google-site-verification" content="d62u_CfO-t">
    
    <meta name="description" content="Arc of Fate — мрачный киберпанк-комикс о девушке, пережившей эксперименты, и бессмертном учёном, который учится быть человеком.">
    <meta name="keywords" content="Arc of Fate, Арка Судьбы, Акихару, NEX, Каролина, научная фантастика, сайт арка судьбы, комикс, киберпанк, веб-комикс, манга">
    <meta name="author" content="apelssinka">
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://w3.org' viewBox='0 0 100 100'%3E%3Ctext x='50' y='80' font-size='70' text-anchor='middle' fill='%23ff3366' font-family='monospace'%3E⌇%3C/text%3E%3C/svg%3E">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #0a0a0a;
            color: #00cc66;
            font-family: 'Courier New', 'Fira Code', monospace;
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Анимированный фон */
        .code-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            overflow: hidden;
            font-family: monospace;
            font-size: 14px;
            color: rgba(0, 204, 102, 0.1);
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-around;
        }
        .code-row {
            white-space: nowrap;
            animation: scrollRow 45s linear infinite;
            width: max-content;
        }
        @keyframes scrollRow {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .glitch-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.15) 0px, rgba(0, 0, 0, 0.15) 2px, transparent 2px, transparent 4px);
            pointer-events: none;
            z-index: 1;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            background: rgba(10, 10, 10, 0.9);
            border: 1px solid #00cc66;
            box-shadow: 0 0 20px rgba(0, 204, 102, 0.2);
            padding: 30px;
            border-radius: 8px;
            position: relative;
            z-index: 2;
        }

        header {
            margin-bottom: 20px;
        }

        h1, h2, h3 {
            color: #ff3366;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 1px solid #ff3366;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: normal;
        }
        h1 { font-size: 2.5rem; border-bottom: none; text-shadow: 0 0 5px #ff3366; }

        a {
            color: #00cc66;
            text-decoration: none;
            border-bottom: 1px dashed #00cc66;
            transition: 0.3s;
        }
        a:hover { color: #ff3366; border-bottom-color: #ff3366; }

        nav {
            margin: 20px 0;
            padding: 10px 0;
            border-top: 1px solid #00cc66;
            border-bottom: 1px solid #00cc66;
            display: flex;
            gap: 20px;
        }

        /* Сетка персонажей */
        .characters-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: center;
            margin: 40px 0;
        }
        .character-card {
            text-align: center;
            cursor: pointer;
            width: 220px;
        }
        .character-frame {
            padding: 15px;
            border: 2px solid #00cc66;
            background: #050505;
            transition: all 0.3s;
        }
        .character-card:hover .character-frame {
            border-color: #ff3366;
            box-shadow: 0 0 15px rgba(255,51,102,0.3);
            transform: translateY(-2px);
        }
        
        .char-thumb-wrapper {
            width: 100%;
            height: 260px;
            overflow: hidden;
            background: #000;
            position: relative;
            margin-bottom: 15px;
            border: 1px solid rgba(0, 204, 102, 0.3);
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        /* Текстовая цифровая мини-заглушка для плашки */
        .matrix-static {
            font-size: 11px;
            color: #00cc66;
            font-family: monospace;
            line-height: 1;
            white-space: pre;
            opacity: 0.7;
            transition: 0.3s;
        }
        .character-card:hover .matrix-static {
            color: #ff3366;
            opacity: 1;
        }

        .character-name {
            font-size: 1.1rem;
            letter-spacing: 2px;
            font-weight: bold;
            color: #00cc66;
            text-transform: uppercase;
        }
        .character-card:hover .character-name { color: #ff3366; }

        /* ОКНО HUD MODAL */
        .hud-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 5, 5, 0.96);
            z-index: 100;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .hud-modal.active { display: flex; }
        
        .hud-window {
            background: #0a0a0a;
            border: 2px solid #00cc66;
            box-shadow: 0 0 35px rgba(0,204,102,0.25);
            width: 100%;
            max-width: 950px;
            display: grid;
            grid-template-columns: 1fr 1.6fr;
            position: relative;
        }
        @media(max-width: 768px) {
            .hud-window { grid-template-columns: 1fr; }
        }

        .hud-left {
            border-right: 1px dashed rgba(0, 204, 102, 0.4);
            padding: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            background: rgba(0, 204, 102, 0.01);
        }
        .hud-right { padding: 30px; position: relative; }

        /* Оболочка цифровой проекции */
        .big-hologram-wrapper {
            width: 100%;
            max-width: 280px;
            height: 360px;
            background: #000;
            border: 2px solid #00cc66;
            position: relative;
            box-shadow: 0 0 20px rgba(0,204,102,0.15);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* ПРОЕКЦИЯ ПЕРСОНАЖА ИЗ ЦИФР (ASCII-СИЛУЭТ) */
        .digital-projection {
            font-size: 8px;
            color: #00ff66;
            font-family: 'Courier New', monospace;
            line-height: 1.1;
            letter-spacing: 1px;
            white-space: pre;
            text-align: center;
            user-select: none;
            opacity: 0.9;
            animation: hologramGlitch 4s infinite alternate;
        }

        .scanline::after {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%);
            background-size: 100% 4px;
            z-index: 2;
            pointer-events: none;
        }

        .laser-line {
            position: absolute;
            width: 100%;
            height: 2px;
            background: rgba(0, 204, 102, 0.6);
            box-shadow: 0 0 10px #00cc66;
            animation: scanLaser 4s linear infinite;
            z-index: 3;
            pointer-events: none;
        }
        @keyframes scanLaser {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }

        @keyframes hologramGlitch {
            0% { transform: translate(0) skew(0deg); opacity: 0.9; text-shadow: none; }
            92% { transform: translate(0) skew(0deg); }
            93% { transform: translate(-3px, 1px) skew(-4deg); color: #ff3366; text-shadow: 1px 0 #00ff66; }
            95% { transform: translate(2px, -1px) skew(2deg); opacity: 0.5; }
            96% { transform: translate(0) skew(0deg); color: #00ff66; text-shadow: none; }
            98% { transform: translate(2px, 0px) skew(-1deg); opacity: 1; }
            100% { transform: translate(0) skew(0deg); }
        }

        .close-hud {
            position: absolute;
            top: 15px; right: 20px;
            color: #ff3366;
            font-size: 1.4rem;
            cursor: pointer;
            border: 1px solid #ff3366;
            padding: 0px 8px;
            background: transparent;
        }
        .close-hud:hover { background: #ff3366; color: #000; }

        .bio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }
        @media(max-width: 500px) {
            .bio-grid { grid-template-columns: 1fr; }
        }
        .bio-row {
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(0, 204, 102, 0.15);
            padding-bottom: 4px;
        }
        .bio-row.full-width { grid-column: 1 / -1; }
        .bio-label { color: #ff3366; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; display: block;}
        
        .hologram-desc-box {
            color: #a0ffb0; 
            font-size: 0.9rem; 
            line-height: 1.6; 
            max-height: 240px; 
